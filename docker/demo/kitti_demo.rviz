Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /KITTI map1
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: KITTI map
      Style: Points
      Size (Pixels): 2
      Size (m): 0.05
      Selectable: true
      Decay Time: 1000000
      Max Points Per Pixel: 4
      Color Transformer: Intensity
      Autocompute Intensity Bounds: true
      Position Transformer: XYZ
      Topic:
        Depth: 100
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /cloud
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 60
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 450
      Focal Point: {X: 120, Y: 100, Z: 0}
      Name: Current View
      Navigate At Cursor: true
      Free Orbit: true
      Near Clip Distance: 0.01
      Pitch: 1.0
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.785398
    Saved: ~
Window Geometry:
  Height: 1000
  Width: 1600
  X: 0
  Y: 0
